# deploy.env.example — copy to deploy.env (gitignored, chmod 600) and fill real tokens
# NEVER commit deploy.env — Vercel revokes exposed vcp_ tokens. Keep deploy.env local only.
# How to deploy (no trial-and-error): read docs/DEPLOY.md or run ./scripts/deploy.sh
#   ./scripts/deploy.sh              — deploy server then client (default, both)
#   ./scripts/deploy.sh --server-only — only Vercel
#   ./scripts/deploy.sh --client-only — only Firebase
# Tokens (rotate if expired):
#   VERCEL_TOKEN: https://vercel.com/account/tokens (scope team_2BZVyUrUv1CN2VEyU43IxnR6, project server)
#   FIREBASE_TOKEN: npx firebase login:ci --project scholarhive-913e4
# Correct parsing — FIREBASE_TOKEN contains // so NOT cut -d= -f2:
#   set -a; source deploy.env; set +a
#   VERCEL_TOKEN=$(grep ^VERCEL_TOKEN deploy.env | cut -d= -f2- | tr -d ' \r\n')
# Keep identical in School-Hive/deploy.env and Schole-hive-server/deploy.env (cp if drift).
# Server project: server (orgId team_2BZVyUrUv1CN2VEyU43IxnR6, projectId prj_RHc6ftkASVUyYGHzJHpWfJZppLkj)
# Client project: scholarhive-913e4 (.firebaserc)
VERCEL_TOKEN=vcp_...from_vercel_dashboard...
FIREBASE_TOKEN=1//...from_firebase_login_ci...
